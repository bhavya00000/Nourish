# Copy to .env and fill in.  cp .env.example .env

# SQLite by default — no external services needed.
# To deploy on Postgres: change the provider in prisma/schema.prisma and put
# your connection string here.
DATABASE_URL="file:./prisma/dev.db"

# Signs session cookies. REQUIRED in production (32+ characters) — the startup
# check refuses to serve requests without it. Generate one with:
#   openssl rand -base64 48
AUTH_SECRET=""

# ---------------------------------------------------------------- optional AI
# Each user can add their own provider and key in Settings. What follows is only
# a SHARED FALLBACK for users who have not — leave it blank to require everyone
# to bring their own key.
#
# Free key from https://console.groq.com/keys
# Without any key everything still works except: automatic estimation of foods
# and exercises that are not in the database, photo logging, meal suggestions,
# training plans and coaching.
GROQ_API_KEY=

# Text model. Reasoning models (gpt-oss, qwen3, deepseek-r1) are handled
# automatically: JSON mode is skipped, reasoning_effort is set low and the
# token budget is raised, because their hidden reasoning otherwise swallows
# the answer and Groq rejects it as json_validate_failed.
GROQ_MODEL=openai/gpt-oss-120b

# Vision model for photo logging. Availability varies by account — run
# `npm run check:ai` to verify yours, and see the README for how to list
# the models your key can actually reach.
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# ---------------------------------------------------------------- optional iOS shortcut
# An iCloud link to a ready-made "Sync to Nourish" shortcut, shown on
# Settings → Health data. Share it with the sync address and token left as
# placeholders: a shared shortcut carries whatever was typed into it.
NEXT_PUBLIC_IOS_SHORTCUT_URL=

# ---------------------------------------------------------------- timezone
# "Today" is worked out on the server, so it must be in your users' timezone.
# Leave unset if the machine already is; set it when hosting somewhere in UTC.
# TZ=Asia/Kolkata
