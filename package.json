{
  "name": "nourish",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:seed": "node --experimental-strip-types scripts/seed.ts",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings scripts/test-parser.ts && node --experimental-strip-types --no-warnings scripts/test-workout.ts && node --experimental-strip-types --no-warnings scripts/test-health.ts",
    "check:ai": "node --experimental-strip-types --no-warnings --conditions=react-server scripts/check-ai.ts",
    "test:workout": "node --experimental-strip-types --no-warnings scripts/test-workout.ts",
    "test:health": "node --experimental-strip-types --no-warnings scripts/test-health.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^17.4.2",
    "fflate": "^0.8.3",
    "jose": "^6.2.12",
    "lucide-react": "^1.44.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "prisma": "^7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sharp": "0.35.4",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "description": "Type what you ate. Nourish works out the calories, macros, targets and what to eat next."
}
